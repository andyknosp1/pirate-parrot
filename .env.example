# Copy this file to .env and fill in your keys. Never commit or share .env.

# ---- Accounts (see docs/software.md) ----
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# The ElevenLabs voice to use (design your own; see docs/voice.md)
ELEVENLABS_VOICE_ID=

# The character's name, used in his prompts and pre-recorded lines
PARROT_NAME=Rotwing

# Decorations the camera can see near the parrot, so he doesn't try to greet them
# (statues, scarecrows and other props are ignored in general; naming yours helps).
# PORCH_DECORATIONS="a pirate dog statue"

# ---- Models (defaults are the fast ones) ----
CLAUDE_MODEL=claude-haiku-4-5
ELEVENLABS_MODEL=eleven_flash_v2_5
DEEPGRAM_MODEL=nova-3
# Model for the pre-recorded clips (make_clips.py); richer, not time-critical
CLIPS_MODEL=eleven_multilingual_v2

# ---- Audio ----
# Blank = system default. On the Pi, ~/.asoundrc points the default at the amp
# (see docs/software.md). Names are matched partially, e.g. MIC_DEVICE=reSpeaker.
# Run `python -m sounddevice` to list devices.
MIC_DEVICE=
SPEAKER_DEVICE=
# Speaker buffer in seconds; raise it (e.g. 0.25) if his voice sounds choppy
SPEAKER_LATENCY=0.15
# His loudness, 0.0 to 1.0 (the MAX98357A amp has no volume knob)
SPEAKER_VOLUME=1.0
# Amp mute: BCM GPIO wired to the amp's SD pin (blank = not wired). Reference build: 16
AMP_SD_PIN=

# ---- Inputs (BCM GPIO numbers) ----
# Motion sensor output, the main trigger. GPIO27 = physical pin 13.
PIR_PIN=27
# Optional backup button between this pin and GND
BUTTON_PIN=17

# ---- Motors (TB6612 driver) ----
# Leave off until the motors are wired and tested (docs/bring-up.md)
MOTORS=off
JAW_PIN_A=23
JAW_PIN_B=24
HEAD_PIN_A=5
HEAD_PIN_B=6
JAW_OPEN_LEVEL=0.06
JAW_CLOSE_LEVEL=0.03
JAW_POWER=0.8
# 0 = keep the head still
HEAD_POWER=0.8

# ---- Camera (costume recognition) ----
# Run `python camera.py` to find the right device number.
CAMERA=off
CAMERA_DEVICE=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_SEND_WIDTH=1024
CAMERA_MIN_BRIGHTNESS=25
# Extra camera settings (Linux, v4l2-ctl). For the Arducam low-light board in 60 Hz countries:
# CAMERA_CONTROLS=power_line_frequency=2,exposure_dynamic_framerate=1
CAMERA_CONTROLS=

# ---- Modes ----
# kids (default) or adult (sassier, a bit tipsy, PG-13). Say a phrase to him to switch.
# Keep kids as the start mode.
START_MODE=kids
ADULT_PHRASE=open the rum locker
KIDS_PHRASE=swab the deck

# ---- Behavior ----
REPLY_WAIT_SECONDS=6       # how long he waits for kids to start talking
MAX_LISTEN_SECONDS=8       # longest single answer he'll listen to
MAX_TURNS=4                # back-and-forths before he says goodbye
GREET_COOLDOWN_SECONDS=20  # rest between groups (motion ignored meanwhile)

# ---- Fine tuning (defaults shown; usually leave these out) ----
# JAW_LEAD_SECONDS=0.04       # start the beak this much before the sound
# JAW_MAX_OPEN_SECONDS=0.5    # never hold the beak open longer than this
# HEAD_MOVE_SECONDS=0.4       # length of one head turn
# HEAD_RIGHT_SCALE=0.9        # shorten right turns if the head drifts right
# AMP_HOLD_SECONDS=1.0        # keep the amp on this long after speech
# FILLER_AFTER_SECONDS=3.5    # second "thinking" sound if a reply is slow
# RETRY_DELAY_SECONDS=0.5     # pause before retrying a failed reply (one retry)
# MAX_FAILS=2                 # errors in one visit before he gives up on that group
# RECHECK_SECONDS=3           # look again this often if the camera saw nobody...
# RECHECKS=5                  # ...up to this many times
